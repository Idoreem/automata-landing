# העתק ל-.env.local לפיתוח מקומי (הקובץ הזה לא נדרש כדי להריץ — הדף עובד בלעדיו)
# בפרודקשן המשתנים מוגדרים ב-Vercel → Settings → Environment Variables

# יעד הלידים: Webhook של Make/CRM.
# ⚠️ בלי זה — לידים רק נרשמים ללוג ולא נשמרים בשום מקום. חובה לפני הזרמת טראפיק.
LEAD_WEBHOOK_URL=

# פיקסל מטא. בלי זה הפיקסל לא נטען בכלל (הדף עובד רגיל).
# מדליק: PageView בכל דף + אירוע Lead בדף התודה.
NEXT_PUBLIC_META_PIXEL_ID=
